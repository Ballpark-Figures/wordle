# Python/cache files
**/__pycache__/
*.pyc

# Virtual environments
.venv/
venv/

# Manim / generated media (never commit renders)
media/
**/media/
*.mp4
*.mov
*.wav
*.mp3

# DaVinci Resolve project backups (a .drp is never uploaded — deliverable is the .mov)
*.drp

# Manim snapshot cache (build artifact, 50+ MB pickles). Scoped to the
# animations tree.
animations/**/cache/

# Compiled solver binary — rebuild with math/solver/build.sh (-march=native, so
# a committed binary would not be portable between machines anyway).
math/solver/optturns

# Machine-local solver working data: resume checkpoints / memo pickles
# (regenerable, can be GBs). Committed results live in math/data/shared/.
math/data/local/

# OS / editor junk
.DS_Store

# Claude config: all machine-local, recreated from dotclaude by /sync-videos.
# commands is a symlink; settings.local.json a real copy (symlinked settings files
# aren't honored). CLAUDE.shared.md / CLAUDE.private.md are REAL COPIES of
# bpkfigures/CLAUDE.md + dotclaude/CLAUDE.md, refreshed every session by the
# SessionStart hook (dotclaude/hooks/refresh-claude-imports.py) and imported by
# CLAUDE.md. They must be real files INSIDE the repo because a CLAUDE.md @import
# will not resolve to a target outside the project dir — see CLAUDE.md "Config
# loading". CLAUDE.private.md is private-repo content: keep it ignored so it can
# never be committed to a video repo (yahtzee and battleship are PUBLIC).
.claude/commands
.claude/settings.local.json
/CLAUDE.shared.md
/CLAUDE.private.md

# Ignore notebook checkpoints
**/.ipynb_checkpoints/
