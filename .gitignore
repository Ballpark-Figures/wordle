# Python/cache files
**/__pycache__/
*.pyc

# Virtual environments
.venv/
venv/

# Manim / generated media (never commit renders)
media/
**/media/
*.mp4
*.mov
*.wav
*.mp3

# DaVinci Resolve local artifacts (per-project, machine-local — never commit).
# .gallery / CacheClip are pointed here by the project's colorGalleryStillsLocation /
# perfCacheClipsLocation settings; a .drp is an editable project backup, never uploaded.
.gallery/
CacheClip/
*.drp
Resolve Project Backups/
# `render NN --stills` staging dir (anim copies + still PNGs + .swap versions).
edit_clips/

# Manim snapshot cache (build artifact, 50+ MB pickles). Scoped to the
# animations tree.
animations/**/cache/

# Compiled solver binaries — rebuild with math/solver/build.sh (-march=native,
# so a committed binary would not be portable between machines anyway).
math/solver/optturns
math/solver/hardturns
math/solver/mmturns
math/solver/ultraturns
math/solver/wturns
# one binary per word length (sh build.sh 7 -> optturns7); same reasoning
math/solver/optturns[0-9]
math/solver/optturns[0-9][0-9]
math/solver/pairsplit
math/solver/secondword
math/solver/secondexact
math/solver/antistall
math/solver/antiexpect
math/solver/cover
math/solver/eldrowmax
math/solver/eldrowmaxg
math/solver/wrongle
math/solver/greens
math/solver/strguess
math/solver/strturns

# Machine-local solver working data: resume checkpoints / memo pickles
# (regenerable, can be GBs). Committed results live in math/data/shared/.
math/data/local/

# OS / editor junk
.DS_Store

# Claude config: all machine-local, recreated from dotclaude by /sync-videos.
# commands is a symlink; settings.local.json a real copy (symlinked settings files
# aren't honored). CLAUDE.shared.md / CLAUDE.private.md are REAL COPIES of
# bpkfigures/CLAUDE.md + dotclaude/CLAUDE.md, refreshed every session by the
# SessionStart hook (dotclaude/hooks/refresh-claude-imports.py) and imported by
# CLAUDE.md. They must be real files INSIDE the repo because a CLAUDE.md @import
# will not resolve to a target outside the project dir — see CLAUDE.md "Config
# loading". CLAUDE.private.md is private-repo content: keep it ignored so it can
# never be committed to a video repo (yahtzee and battleship are PUBLIC).
.claude/commands
.claude/settings.local.json
/CLAUDE.shared.md
/CLAUDE.private.md

# Ignore notebook checkpoints
**/.ipynb_checkpoints/

# Solver outputs too large for GitHub (over 50 MB; most are over the 100 MB
# hard limit, so a push carrying them is rejected outright). They stay on the
# machine that produced them and are regenerable from their wrappers. The
# RESULT of each one is committed beside it as a digest: a `.summary` holding
# the run's own trailing `#` block verbatim (mean, standard error, histogram),
# or a `.head.csv` holding the best 1000 rows of a best-first ranking, plus
# that ranking's `.meta`. Listed file by file rather than by glob, because
# same-named siblings (k1/k2 at t=1000000) are small enough to commit.
